# Copy to .env (git-ignored) and choose a password. The stack binds to
# 127.0.0.1 only, but the value still belongs outside version control.
#
#   cp .env.example .env && $EDITOR .env
#   set -a; . .env; set +a
#   docker compose up -d && python3 load.py

SRAG_DB_USER=srag
SRAG_DB_NAME=srag
SRAG_DB_PORT=5433
SRAG_DB_PASSWORD=
